    from app.agents.nodes.grounding_critic import (
        _explicit_query_source_entity_mismatch as mismatch,
    )

    assert mismatch(
        "What was the exact 2024 revenue of the fictional company ZephyrNexus?",
        "ZephyrNexus Annual Report 2024",
